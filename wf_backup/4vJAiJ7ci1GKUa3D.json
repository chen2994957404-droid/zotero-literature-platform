                      "parameters":  {
                                         "method":  "PUT",
                                         "url":  "={{ $json.uploadUrl }}",
                                         "sendBody":  true,
                                         "contentType":  "binary",
                                         "options":  {

                                                     }
                                     },
                      "id":  "713079bf-d829-49c0-b445-2d5533c893db",
