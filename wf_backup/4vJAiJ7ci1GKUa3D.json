                      "parameters":  {
                                         "formTitle":  "上传文档转 Markdown（MinerU）",
                                         "formDescription":  "上传 PDF / Word / PPT / 图片，通过 MinerU API 解析为 Markdown",
                                         "formFields":  {
                                                            "values":  [
                                                                           {
                                                                               "fieldLabel":  "文档文件",
                                                                               "fieldType":  "file",
                                                                               "requiredField":  true
                                                                           }
                                                                       ]
                                                        },
                                         "options":  {

                                                     }
                                     },
                      "id":  "163ce923-564e-4edf-8aa5-381b6306ad14",
                      "name":  "1. 表单上传触发",
                      "type":  "n8n-nodes-base.formTrigger",
                      "typeVersion":  2.2,
                      "position":  [
                                       -2080,
                                       -160
                                   ],
                      "webhookId":  "9ea3c31b-bc6a-49ac-aef4-5250712360fc"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// 从表单二进制数据里取出文件名，生成唯一 data_id，供后续步骤复用\nconst binaryKeys = Object.keys(items[0].binary || {});\nif (binaryKeys.length === 0) {\n  throw new Error(\u0027未检测到上传文件，请检查表单文件字段名称\u0027);\n}\nconst binaryKey = binaryKeys[0];\nconst fileName = items[0].binary[binaryKey].fileName || \u0027document.pdf\u0027;\nconst dataId = `file_${Date.now()}`;\n\nreturn [\n  {\n    json: {\n      fileName,\n      dataId,\n      binaryKey\n    },\n    binary: items[0].binary\n  }\n];"
                                     },
                      "id":  "aad312d4-d019-477d-87ab-faee326405ee",
                      "name":  "2. 提取文件信息",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       -1856,
                                       -160
                                   ]
                  },
                  {
                      "parameters":  {
                                         "method":  "POST",
                                         "url":  "https://mineru.net/api/v4/file-urls/batch",
                                         "sendHeaders":  true,
                                         "headerParameters":  {
                                                                  "parameters":  [
                                                                                     {
                                                                                         "name":  "Content-Type",
                                                                                         "value":  "application/json"
                                                                                     },
                                                                                     {
                                                                                         "name":  "Authorization",
                                                                                         "value":  "={{ \u0027Bearer \u0027 + $(\u0027设置：MinerU Token\u0027).first().json.token }}"
                                                                                     }
                                                                                 ]
                                                              },
                                         "sendBody":  true,
                                         "specifyBody":  "json",
                                         "jsonBody":  "={\n  \"enable_formula\": true,\n  \"enable_table\": true,\n  \"language\": \"ch\",\n  \"model_version\": \"vlm\",\n  \"files\": [\n    {\n      \"name\": \"{{ $json.fileName }}\",\n      \"is_ocr\": true,\n      \"data_id\": \"{{ $json.dataId }}\"\n    }\n  ]\n}",
                                         "options":  {

                                                     }
                                     },
                      "id":  "9dc81316-69d2-4c98-a299-a4dcbd03c2a9",
                      "name":  "3. 申请上传地址(file-urls批量)",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       -1616,
                                       -160
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// 说明：官方文档未给出本节点响应体的完整字段结构。\n// 常见批量上传接口一般会返回类似：\n//   { \"code\":0, \"data\": { \"batch_id\": \"...\", \"file_urls\": [\"https://...\"] } }\n// 这里假设返回结构为 data.file_urls（数组，顺序对应提交的 files 数组）\n// 如果实际字段名不同，请打开 n8n 执行日志查看真实响应，并修改本节点对应字段。\n\nconst resp = items[0].json;\nconst data = resp.data || {};\n\nconst uploadUrl = (data.file_urls \u0026\u0026 data.file_urls[0]) || data.upload_url || null;\nconst batchId = data.batch_id || data.batchId || null;\n\nif (!uploadUrl) {\n  throw new Error(\u0027未能从响应中解析出上传地址，请检查 file-urls/batch 接口真实返回结构: \u0027 + JSON.stringify(resp));\n}\n\nconst prev = $(\u00272. 提取文件信息\u0027).first();\n\nreturn [\n  {\n    json: {\n      uploadUrl,\n      batchId,\n      fileName: prev.json.fileName,\n      dataId: prev.json.dataId\n    },\n    binary: prev.binary\n  }\n];"
                                     },
                      "id":  "5fecad34-0f35-453a-9a15-f6e9635cea3c",
                      "name":  "4. 解析上传地址",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       -1376,
