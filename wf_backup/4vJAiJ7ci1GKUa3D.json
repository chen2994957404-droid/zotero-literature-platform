                      "id":  "0b00ffc1-df68-41cd-af72-290fb5afa3f4",
                      "name":  "7. 按batch_id查询task_id",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       -656,
                                       -160
                                   ],
                      "notes":  "MinerU 批量上传后一般走 extract-results/batch/{batch_id} 拿到对应 task_id 列表，具体字段以官方实际返回为准，必要时改成官方文档里的真实 endpoint"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// 从批量结果里取出第一个（本流程单文件场景）对应的 task_id\n// 同样：字段名以官方真实响应为准，这里给出一个合理假设并做兜底\nconst resp = items[0].json;\nconst data = resp.data || {};\nlet taskId = null;\n\nif (Array.isArray(data.extract_result) \u0026\u0026 data.extract_result.length \u003e 0) {\n  taskId = data.extract_result[0].task_id;\n} else if (data.task_id) {\n  taskId = data.task_id;\n}\n\nif (!taskId) {\n  throw new Error(\u0027未能取到 task_id，请检查 batch 查询接口真实返回结构: \u0027 + JSON.stringify(resp));\n}\n\nreturn [{ json: { taskId } }];"
                                     },
